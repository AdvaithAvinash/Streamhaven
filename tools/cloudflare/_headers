# Cloudflare Pages response headers for the Streamhaven web build.
# no-cache = the browser always revalidates, so a new deploy shows up on reload while testing.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
/vendor/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=86400
